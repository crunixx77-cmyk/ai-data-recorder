<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <Button
        android:id="@+id/btnRecord"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        android:text="Tekan &amp; Tahan untuk Merekam"
        android:textSize="20sp"
        android:contentDescription="Tombol Rekam. Tekan dan tahan terus untuk merekam suara, lepaskan untuk selesai." />

    <Button
        android:id="@+id/btnList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:text="Daftar Rekaman"
        android:textSize="18sp"
        android:contentDescription="Tombol Daftar Rekaman. Ketuk dua kali untuk melihat hasil rekaman." />

</LinearLayout>
